import PvsNP.SixBySix

/-!
# The middle layer of the 6 × 6 permanent: 15 split products in the limit

Generated by `python3 garbage_fast.py 3 --lean`. Rows `0, …, 5`, column blocks `{0, 1, 2}` and
`{3, 4, 5}`. Ten weighted squares, one for each splitting `R | Rᶜ` of the rows, leave behind
`∑ c_R * perm(R) * perm(Rᶜ)` in the first block, with `c = [3, -15, 3, 9, -18, -6, 6, -18, 6, 30]` for the splittings
`012, 013, 014, 015, 023, 024, 025, 034, 035, 045`. That combination is cancelled by five split
products: two for `012|345`, two for `013|245` and `12 * det(024) * det(135)`.
-/

namespace PvsNP

open Matrix

section Ring

variable {R : Type*} [CommRing R]

/-- Generalised matrix function of the row vectors `u, v, w` on columns `p, q, r`: one
coefficient for each permutation (permanent: all `1`, determinant: the signs). -/
def gmf (a b c d e f : R) (p q r : Fin 6) (u v w : Fin 6 → R) : R :=
  a * (u p * v q * w r) + b * (u p * v r * w q) + c * (u q * v p * w r)
    + d * (u q * v r * w p) + e * (u r * v p * w q) + f * (u r * v q * w p)

/-- `a` times the first-block permanent plus `lam * b` times the second-block permanent. -/
def wsq (a b lam : R) (u v w : Fin 6 → R) : R :=
  a * perm3 0 1 2 u v w + lam * (b * perm3 3 4 5 u v w)

/-- What the ten weighted squares leave behind in the first block. -/
def garbage5 (A : Matrix (Fin 6) (Fin 6) R) : R :=
  3 * (perm3 0 1 2 (A 0) (A 1) (A 2) * perm3 0 1 2 (A 3) (A 4) (A 5))
    + (-15) * (perm3 0 1 2 (A 0) (A 1) (A 3) * perm3 0 1 2 (A 2) (A 4) (A 5))
    + 3 * (perm3 0 1 2 (A 0) (A 1) (A 4) * perm3 0 1 2 (A 2) (A 3) (A 5))
    + 9 * (perm3 0 1 2 (A 0) (A 1) (A 5) * perm3 0 1 2 (A 2) (A 3) (A 4))
    + (-18) * (perm3 0 1 2 (A 0) (A 2) (A 3) * perm3 0 1 2 (A 1) (A 4) (A 5))
    + (-6) * (perm3 0 1 2 (A 0) (A 2) (A 4) * perm3 0 1 2 (A 1) (A 3) (A 5))
    + 6 * (perm3 0 1 2 (A 0) (A 2) (A 5) * perm3 0 1 2 (A 1) (A 3) (A 4))
    + (-18) * (perm3 0 1 2 (A 0) (A 3) (A 4) * perm3 0 1 2 (A 1) (A 2) (A 5))
    + 6 * (perm3 0 1 2 (A 0) (A 3) (A 5) * perm3 0 1 2 (A 1) (A 2) (A 4))
    + 30 * (perm3 0 1 2 (A 0) (A 4) (A 5) * perm3 0 1 2 (A 1) (A 2) (A 3))

/-- Five split products. -/
def extras5 (A : Matrix (Fin 6) (Fin 6) R) : R :=
  (-2) * (gmf 3 3 (-1) (-2) (-1) (-2) 0 1 2 (A 0) (A 1) (A 2) * gmf 9 6 3 (-3) (-6) (-9) 0 1 2 (A 3) (A 4) (A 5))
    + (-2) * (gmf (-1) (-2) 3 3 (-2) (-1) 0 1 2 (A 0) (A 1) (A 2) * gmf 3 (-3) 9 6 (-9) (-6) 0 1 2 (A 3) (A 4) (A 5))
    + (-2) * (gmf 5 5 (-7) 2 (-7) 2 0 1 2 (A 0) (A 1) (A 3) * gmf 2 1 1 (-1) (-1) (-2) 0 1 2 (A 2) (A 4) (A 5))
    + (-2) * (gmf (-7) 2 5 5 2 (-7) 0 1 2 (A 0) (A 1) (A 3) * gmf 1 (-1) 2 1 (-2) (-1) 0 1 2 (A 2) (A 4) (A 5))
    + 12 * (gmf 1 (-1) (-1) 1 1 (-1) 0 1 2 (A 0) (A 2) (A 4) * gmf 1 (-1) (-1) 1 1 (-1) 0 1 2 (A 1) (A 3) (A 5))

/-- The ten weighted squares. -/
def wsquares (A : Matrix (Fin 6) (Fin 6) R) (lam : R) : R :=
  (wsq 3 1 lam (A 0) (A 1) (A 2)) * (wsq 90 30 lam (A 3) (A 4) (A 5))
    + (wsq (-15) 1 lam (A 0) (A 1) (A 3)) * (wsq 90 (-6) lam (A 2) (A 4) (A 5))
    + (wsq 3 1 lam (A 0) (A 1) (A 4)) * (wsq 90 30 lam (A 2) (A 3) (A 5))
    + (wsq 9 1 lam (A 0) (A 1) (A 5)) * (wsq 90 10 lam (A 2) (A 3) (A 4))
    + (wsq (-18) 1 lam (A 0) (A 2) (A 3)) * (wsq 90 (-5) lam (A 1) (A 4) (A 5))
    + (wsq (-6) 1 lam (A 0) (A 2) (A 4)) * (wsq 90 (-15) lam (A 1) (A 3) (A 5))
    + (wsq 6 1 lam (A 0) (A 2) (A 5)) * (wsq 90 15 lam (A 1) (A 3) (A 4))
    + (wsq (-18) 1 lam (A 0) (A 3) (A 4)) * (wsq 90 (-5) lam (A 1) (A 2) (A 5))
    + (wsq 6 1 lam (A 0) (A 3) (A 5)) * (wsq 90 15 lam (A 1) (A 2) (A 4))
    + (wsq 30 1 lam (A 0) (A 4) (A 5)) * (wsq 90 3 lam (A 1) (A 2) (A 3))

/-- What the weighted squares leave behind in the second block. It enters with `lam ^ 2`. -/
def wrest (A : Matrix (Fin 6) (Fin 6) R) : R :=
  30 * (perm3 3 4 5 (A 0) (A 1) (A 2) * perm3 3 4 5 (A 3) (A 4) (A 5))
    + (-6) * (perm3 3 4 5 (A 0) (A 1) (A 3) * perm3 3 4 5 (A 2) (A 4) (A 5))
    + 30 * (perm3 3 4 5 (A 0) (A 1) (A 4) * perm3 3 4 5 (A 2) (A 3) (A 5))
    + 10 * (perm3 3 4 5 (A 0) (A 1) (A 5) * perm3 3 4 5 (A 2) (A 3) (A 4))
    + (-5) * (perm3 3 4 5 (A 0) (A 2) (A 3) * perm3 3 4 5 (A 1) (A 4) (A 5))
    + (-15) * (perm3 3 4 5 (A 0) (A 2) (A 4) * perm3 3 4 5 (A 1) (A 3) (A 5))
    + 15 * (perm3 3 4 5 (A 0) (A 2) (A 5) * perm3 3 4 5 (A 1) (A 3) (A 4))
    + (-5) * (perm3 3 4 5 (A 0) (A 3) (A 4) * perm3 3 4 5 (A 1) (A 2) (A 5))
    + 15 * (perm3 3 4 5 (A 0) (A 3) (A 5) * perm3 3 4 5 (A 1) (A 2) (A 4))
    + 3 * (perm3 3 4 5 (A 0) (A 4) (A 5) * perm3 3 4 5 (A 1) (A 2) (A 3))

/-- **Five split products cancel the first-block garbage.** -/
theorem garbage5_add_extras5 (A : Matrix (Fin 6) (Fin 6) R) : garbage5 A + extras5 A = 0 := by
  simp only [garbage5, extras5, gmf, perm3]
  ring

/-- **Fifteen-term identity.** -/
theorem fifteen_term_identity (A : Matrix (Fin 6) (Fin 6) R) (lam : R) :
    90 * lam * A.permanent = wsquares A lam + 90 * extras5 A - lam ^ 2 * wrest A := by
  rw [permanent_fin_six_laplace]
  simp only [wsquares, extras5, wrest, wsq, gmf, perm3]
  ring

end Ring

section Field

variable {K : Type*} [Field K] [CharZero K]

/-- **Border bound for the 6 × 6 permanent.** For every nonzero `lam`, the permanent plus
`lam * wrest A / 90` is a sum of fifteen split products. Laplace expansion uses twenty. -/
theorem permanent_sub_eq_fifteen_split (lam : K) (hlam : lam ≠ 0) :
    ∃ ts : List (Matrix (Fin 6) (Fin 6) K → K), ts.length = 15 ∧ (∀ t ∈ ts, IsSplit3 t) ∧
      ∀ A : Matrix (Fin 6) (Fin 6) K, A.permanent + lam * (wrest A / 90) = (ts.map fun t => t A).sum := by
  refine ⟨[
      mk 0 1 2 3 4 5 (fun u v w => (90 * lam)⁻¹ * wsq 3 1 lam u v w) (fun u v w => wsq 90 30 lam u v w),
      mk 0 1 3 2 4 5 (fun u v w => (90 * lam)⁻¹ * wsq (-15) 1 lam u v w) (fun u v w => wsq 90 (-6) lam u v w),
      mk 0 1 4 2 3 5 (fun u v w => (90 * lam)⁻¹ * wsq 3 1 lam u v w) (fun u v w => wsq 90 30 lam u v w),
      mk 0 1 5 2 3 4 (fun u v w => (90 * lam)⁻¹ * wsq 9 1 lam u v w) (fun u v w => wsq 90 10 lam u v w),
      mk 0 2 3 1 4 5 (fun u v w => (90 * lam)⁻¹ * wsq (-18) 1 lam u v w) (fun u v w => wsq 90 (-5) lam u v w),
      mk 0 2 4 1 3 5 (fun u v w => (90 * lam)⁻¹ * wsq (-6) 1 lam u v w) (fun u v w => wsq 90 (-15) lam u v w),
      mk 0 2 5 1 3 4 (fun u v w => (90 * lam)⁻¹ * wsq 6 1 lam u v w) (fun u v w => wsq 90 15 lam u v w),
      mk 0 3 4 1 2 5 (fun u v w => (90 * lam)⁻¹ * wsq (-18) 1 lam u v w) (fun u v w => wsq 90 (-5) lam u v w),
      mk 0 3 5 1 2 4 (fun u v w => (90 * lam)⁻¹ * wsq 6 1 lam u v w) (fun u v w => wsq 90 15 lam u v w),
      mk 0 4 5 1 2 3 (fun u v w => (90 * lam)⁻¹ * wsq 30 1 lam u v w) (fun u v w => wsq 90 3 lam u v w),
      mk 0 1 2 3 4 5 (fun u v w => lam⁻¹ * (-2) * gmf 3 3 (-1) (-2) (-1) (-2) 0 1 2 u v w) (fun u v w => gmf 9 6 3 (-3) (-6) (-9) 0 1 2 u v w),
      mk 0 1 2 3 4 5 (fun u v w => lam⁻¹ * (-2) * gmf (-1) (-2) 3 3 (-2) (-1) 0 1 2 u v w) (fun u v w => gmf 3 (-3) 9 6 (-9) (-6) 0 1 2 u v w),
      mk 0 1 3 2 4 5 (fun u v w => lam⁻¹ * (-2) * gmf 5 5 (-7) 2 (-7) 2 0 1 2 u v w) (fun u v w => gmf 2 1 1 (-1) (-1) (-2) 0 1 2 u v w),
      mk 0 1 3 2 4 5 (fun u v w => lam⁻¹ * (-2) * gmf (-7) 2 5 5 2 (-7) 0 1 2 u v w) (fun u v w => gmf 1 (-1) 2 1 (-2) (-1) 0 1 2 u v w),
      mk 0 2 4 1 3 5 (fun u v w => lam⁻¹ * 12 * gmf 1 (-1) (-1) 1 1 (-1) 0 1 2 u v w) (fun u v w => gmf 1 (-1) (-1) 1 1 (-1) 0 1 2 u v w)], rfl, ?_, ?_⟩
  · intro t ht
    simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
    rcases ht with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact isSplit3_mk _ _ _ _ _ _ (by decide) _ _
  · intro A
    have h := fifteen_term_identity A lam
    simp only [wsquares, extras5] at h
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, mk]
    have h0 : ((90 : K)) ≠ 0 := by norm_num
    field_simp
    linear_combination h

end Field

end PvsNP

