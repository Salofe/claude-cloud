import OMAReductions.R_oeis_a000166_R1

/-!
# Step H1 of the reduction oeis-a000166.R1

For every index n with 2 < n and n at most 10000 other than n = 4, the derangement number D n
is not a perfect power. It suffices to exclude prime exponents K. For each n a certificate gives
a prime p together with the exact exponent e of p in D n; if D n = b ^ K then K divides e. When
e is 1 this is already a contradiction; otherwise, for each prime K dividing e, a small prime q
with q congruent to 1 modulo K and D n not a K-th power residue modulo q is found by search
(Fermat little theorem). The kernel checks all certificates in one pass computing D n by the
recurrence D (n + 2) = (n + 1) (D n + D (n + 1)). Primality of the certificate primes, all below
10201, is checked by a table up to 100 and coprimality with the product of the primes up to 100.
Only Mathlib is used besides the definition of the step.
-/

namespace OMA.Helpers

/-- Bit mask of the primes up to 100. -/
def MASK : ℕ := 159085582874019712269820766380

/-- Product of the primes up to 100. -/
def PRIM : ℕ := 2305567963945518424753102147331756070

/-- A primality test valid below 10201: a table lookup up to 100, and coprimality with the
product of the primes up to 100 above it. -/
def isP (p : ℕ) : Bool :=
  if p ≤ 100 then MASK / 2 ^ p % 2 == 1 else (decide (p < 10201) && Nat.gcd p PRIM == 1)

theorem small_char : ∀ p, p < 101 →
    (MASK / 2 ^ p % 2 = 1 ↔ (2 ≤ p ∧ ∀ m, m < p → 2 ≤ m → p % m ≠ 0)) := by
  decide +kernel

theorem prim_dvd : ∀ r, r < 101 → MASK / 2 ^ r % 2 = 1 → PRIM % r = 0 := by
  decide +kernel

theorem small_prime_iff (p : ℕ) (hp : p ≤ 100) : MASK / 2 ^ p % 2 = 1 ↔ p.Prime := by
  rw [small_char p (by omega), Nat.prime_def_lt']
  constructor
  · rintro ⟨h2, h⟩
    exact ⟨h2, fun m hm1 hm2 hd => h m hm2 hm1 (Nat.mod_eq_zero_of_dvd hd)⟩
  · rintro ⟨h2, h⟩
    exact ⟨h2, fun m hm1 hm2 hd => h m hm2 hm1 (Nat.dvd_of_mod_eq_zero hd)⟩

theorem isP_sound (p : ℕ) (h : isP p = true) : p.Prime := by
  unfold isP at h
  split_ifs at h with hp
  · exact (small_prime_iff p hp).1 (by simpa using h)
  · simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
    obtain ⟨hlt, hg⟩ := h
    by_contra hnp
    have hpos : 0 < p := by omega
    have hsq := Nat.minFac_sq_le_self hpos hnp
    have hr : (Nat.minFac p).Prime := Nat.minFac_prime (by omega)
    have hr100 : Nat.minFac p ≤ 100 := by
      by_contra hc
      have h101 := Nat.pow_le_pow_left (show 101 ≤ Nat.minFac p by omega) 2
      omega
    have hrP : Nat.minFac p ∣ PRIM :=
      Nat.dvd_of_mod_eq_zero (prim_dvd _ (by omega) ((small_prime_iff _ hr100).2 hr))
    have hd := Nat.dvd_gcd (Nat.minFac_dvd p) hrP
    rw [hg] at hd
    exact hr.one_lt.ne' (Nat.dvd_one.1 hd)

theorem isP_complete (k : ℕ) (hk : k ≤ 100) (h : k.Prime) : isP k = true := by
  unfold isP
  rw [if_pos hk]
  simpa using (small_prime_iff k hk).2 h

/-- The number `N` is not a `k`-th power residue modulo the prime `q`. -/
def qtest (N k q : ℕ) : Bool :=
  isP q && q % k == 1 && N % q != 0 && (N % q) ^ ((q - 1) / k) % q != 1

theorem qtest_sound (N k q b : ℕ) (hk : 0 < k) (h : qtest N k q = true) (hN : N = b ^ k) :
    False := by
  simp only [qtest, Bool.and_eq_true, bne_iff_ne, ne_eq, beq_iff_eq] at h
  obtain ⟨⟨⟨hq, hmod⟩, hNq⟩, hpow⟩ := h
  have hq' := isP_sound q hq
  have := Fact.mk hq'
  have hdm := Nat.div_add_mod q k
  rw [hmod] at hdm
  have hqm : q - 1 = k * (q / k) := by omega
  have hdiv : (q - 1) / k = q / k := by rw [hqm, Nat.mul_div_cancel_left _ hk]
  have hb : (b : ZMod q) ≠ 0 := by
    intro hb0
    apply hNq
    have hqb : q ∣ b := (ZMod.natCast_eq_zero_iff b q).1 hb0
    rw [hN]
    exact Nat.mod_eq_zero_of_dvd (dvd_pow hqb hk.ne')
  apply hpow
  rw [← ZMod.val_natCast, hdiv]
  push_cast
  rw [ZMod.natCast_mod, hN]
  push_cast
  rw [← pow_mul, ← hqm, ZMod.pow_card_sub_one_eq_one hb, ZMod.val_one]

/-- Search for a prime below 50 witnessing that `N` is not a `k`-th power. -/
def ktest (N k : ℕ) : Bool := (List.range 50).any (fun q => qtest N k q)

/-- Certificate: `p` is prime, `p ^ e` exactly divides `N`, and for every prime `k` dividing
`e` the number `N` is not a `k`-th power residue modulo some small prime. -/
def cert (N p e : ℕ) : Bool :=
  isP p && decide (1 ≤ e) && decide (e ≤ 100) && N % p ^ e == 0 && N % p ^ (e + 1) != 0 &&
    (List.range (e + 1)).all (fun k => !(isP k && e % k == 0) || ktest N k)

theorem cert_sound (N p e b K : ℕ) (hK : K.Prime) (h : cert N p e = true) (hN : N = b ^ K) :
    False := by
  simp only [cert, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, bne_iff_ne, ne_eq,
    List.all_eq_true, List.mem_range, Bool.or_eq_true, Bool.not_eq_true',
    Bool.and_eq_false_iff] at h
  obtain ⟨⟨⟨⟨⟨hp, he1⟩, he100⟩, hdvd⟩, hndvd⟩, hall⟩ := h
  have hp' := isP_sound p hp
  have hN0 : N ≠ 0 := by
    intro h0
    rw [h0] at hndvd
    exact hndvd (Nat.zero_mod _)
  have hle : e ≤ N.factorization p :=
    (hp'.pow_dvd_iff_le_factorization hN0).1 (Nat.dvd_of_mod_eq_zero hdvd)
  have hlt : N.factorization p < e + 1 := by
    by_contra hc
    exact hndvd (Nat.mod_eq_zero_of_dvd
      ((hp'.pow_dvd_iff_le_factorization hN0).2 (by omega)))
  have hfe : N.factorization p = e := by omega
  have hKe : K ∣ e := by
    rw [← hfe, hN, Nat.factorization_pow]
    exact ⟨b.factorization p, by simp⟩
  have hKle : K ≤ e := Nat.le_of_dvd (by omega) hKe
  rcases hall K (by omega) with (hc | hc) | hc
  · rw [isP_complete K (by omega) hK] at hc
    simp at hc
  · rw [Nat.mod_eq_zero_of_dvd hKe] at hc
    simp at hc
  · simp only [ktest, List.any_eq_true, List.mem_range] at hc
    obtain ⟨q, _, hq⟩ := hc
    exact qtest_sound N K q b hK.pos hq hN

/-- Run the certificates of the stream `S` on the indices `n, n + 1, ...`, carrying the
derangement numbers `x = D n` and `y = D (n + 1)`. -/
def loop : ℕ → ℕ → ℕ → ℕ → ℕ → Bool
  | 0, _, _, _, _ => true
  | f + 1, n, x, y, S =>
    (n == 4 || cert x (S % 16384) (S / 16384 % 16)) &&
      loop f (n + 1) y ((n + 1) * (x + y)) (S / 262144)

theorem loop_sound : ∀ f n S, loop f n (numDerangements n) (numDerangements (n + 1)) S = true →
    ∀ m, n ≤ m → m < n + f → m ≠ 4 → ∀ b K, K.Prime → numDerangements m ≠ b ^ K
  | 0, n, S, _ => by intro m h1 h2; omega
  | f + 1, n, S, h => by
    intro m h1 h2 h4 b K hK hm
    simp only [loop, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at h
    obtain ⟨hc, hl⟩ := h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · rcases hc with h4' | hc
      · exact h4 h4'
      · exact cert_sound _ _ _ _ _ hK hc hm
    · rw [show (n + 1) * (numDerangements n + numDerangements (n + 1)) =
          numDerangements (n + 1 + 1) from (numDerangements_add_two n).symm] at hl
      exact loop_sound f (n + 1) _ hl m (by omega) (by omega) h4 b K hK hm

/-- The certificate stream: for each index `n` from 3 to 10000, a word of 18 bits holding a
prime `p` (14 bits) and the exact exponent `e` of `p` in `D n` (4 bits). -/
def S0 : ℕ := 

theorem big : loop 9998 3 2 9 S0 = true := by
  decide +kernel

end OMA.Helpers

theorem OMA.solution : OMA.R_oeis_a000166_R1.H1 := by
  intro n h2 h10 hex
  obtain ⟨a, k, _, hk, heq⟩ := hex
  by_contra hn4
  have hK := Nat.minFac_prime (show k ≠ 1 by omega)
  obtain ⟨j, hj⟩ := Nat.minFac_dvd k
  have hb : numDerangements n = (a ^ j) ^ k.minFac := by
    rw [heq, ← pow_mul, mul_comm, ← hj]
  have hl := OMA.Helpers.big
  rw [show (2 : ℕ) = numDerangements 3 by decide,
    show (9 : ℕ) = numDerangements (3 + 1) by decide] at hl
  exact OMA.Helpers.loop_sound 9998 3 _ hl n (by omega) (by omega) hn4 (a ^ j) k.minFac hK hb
