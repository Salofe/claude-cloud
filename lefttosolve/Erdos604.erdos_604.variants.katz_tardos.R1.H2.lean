import OMAReductions.R_Erdos604_erdos_604_variants_katz_tardos_R1
import Mathlib

/-!
# Step H2 of the reduction Erdos604.erdos_604.variants.katz_tardos.R1

Let `x : ι → ℝ²` be a finite injective configuration and write `D a b` for the squared distance
between `x a` and `x b`. Let `A ⊆ ℝ` be the `ℚ`-algebra generated by all coordinates of the
points and by the inverses of all differences `D a b - D c d`. It is a finitely generated
`ℚ`-algebra, so by Zariski's lemma its residue field at a maximal ideal is a finite extension of
`ℚ`, which embeds into the algebraic closure. This gives a `ℚ`-algebra map `ψ : A → ℚ̄`. Every
nonzero difference `D a b - D c d` is a unit of `A`, hence `ψ` keeps it nonzero, so `ψ` preserves
the equality pattern of the squared distances. With `i² = -1` in `ℚ̄`, put
`u a = ψ(x a 0) + i ψ(x a 1)` and `v a = ψ(x a 0) - i ψ(x a 1)`; then
`(u a - u b) (v a - v b) = ψ (D a b)`. The field generated by `i` and the finitely many images
of coordinates is a number field. Injectivity of `u` and `v` follows from the equality pattern,
since `D a b = 0` only for `a = b`.
-/

namespace OMA.Helpers

/-- A finitely generated `ℚ`-subalgebra of `ℝ` admits a `ℚ`-algebra map to `ℚ̄`. -/
theorem exists_algHom_to_algClosure (T : Set ℝ) (hT : T.Finite) :
    Nonempty (Algebra.adjoin ℚ T →ₐ[ℚ] AlgebraicClosure ℚ) := by
  have : Algebra.FiniteType ℚ (Algebra.adjoin ℚ T) := Algebra.FiniteType.adjoin_of_finite hT
  obtain ⟨m, hm⟩ := Ideal.exists_maximal (Algebra.adjoin ℚ T)
  let := Ideal.Quotient.field m
  have := finite_of_finite_type_of_isJacobsonRing ℚ (Algebra.adjoin ℚ T ⧸ m)
  have : Algebra.IsAlgebraic ℚ (Algebra.adjoin ℚ T ⧸ m) := Algebra.IsAlgebraic.of_finite _ _
  have : Module.IsTorsionFree ℚ (Algebra.adjoin ℚ T ⧸ m) := DivisionSemiring.to_moduleIsTorsionFree
  exact ⟨(IsAlgClosed.lift : (Algebra.adjoin ℚ T ⧸ m) →ₐ[ℚ] AlgebraicClosure ℚ).comp
    (Ideal.Quotient.mkₐ ℚ m)⟩

theorem dist_eq_sqrt (p q : EuclideanSpace ℝ (Fin 2)) :
    dist p q = Real.sqrt ((p 0 - q 0) ^ 2 + (p 1 - q 1) ^ 2) := by
  rw [EuclideanSpace.dist_eq, Fin.sum_univ_two, Real.dist_eq, Real.dist_eq, sq_abs, sq_abs]

/-- Every element of `ℚ̄` is integral over `ℚ`, for the canonical `ℚ`-algebra structure. -/
theorem isIntegral_algClosure (z : AlgebraicClosure ℚ) : IsIntegral ℚ z := by
  have h1 : @IsIntegral ℚ (AlgebraicClosure ℚ) _ _ (AlgebraicClosure.instAlgebra ℚ) z :=
    Algebra.IsIntegral.isIntegral z
  convert h1
  exact Subsingleton.elim _ _

end OMA.Helpers

theorem OMA.solution : OMA.R_Erdos604_erdos_604_variants_katz_tardos_R1.H2 := by
  intro ι _ x hx
  classical
  have : Fintype ι := Fintype.ofFinite ι
  let D : ι → ι → ℝ := fun a b => (x a 0 - x b 0) ^ 2 + (x a 1 - x b 1) ^ 2
  have hdist : ∀ a b c d, dist (x a) (x b) = dist (x c) (x d) ↔ D a b = D c d := by
    intro a b c d
    rw [OMA.Helpers.dist_eq_sqrt, OMA.Helpers.dist_eq_sqrt]
    exact Real.sqrt_inj (by positivity) (by positivity)
  let T : Set ℝ := Set.range (fun p : ι × Fin 2 => x p.1 p.2) ∪
    Set.range (fun q : ι × ι × ι × ι => (D q.1 q.2.1 - D q.2.2.1 q.2.2.2)⁻¹)
  have hT : T.Finite := (Set.finite_range _).union (Set.finite_range _)
  obtain ⟨ψ⟩ := OMA.Helpers.exists_algHom_to_algClosure T hT
  let X : ι → Fin 2 → Algebra.adjoin ℚ T := fun a k =>
    ⟨x a k, Algebra.subset_adjoin (Or.inl ⟨(a, k), rfl⟩)⟩
  let DA : ι → ι → Algebra.adjoin ℚ T := fun a b => (X a 0 - X b 0) ^ 2 + (X a 1 - X b 1) ^ 2
  have hDA : ∀ a b, ((DA a b : Algebra.adjoin ℚ T) : ℝ) = D a b := by
    intro a b
    rfl
  have hψ : ∀ a b c d, ψ (DA a b) = ψ (DA c d) ↔ D a b = D c d := by
    intro a b c d
    constructor
    · intro h
      by_contra hne
      have hne' : D a b - D c d ≠ 0 := sub_ne_zero.mpr hne
      let e : Algebra.adjoin ℚ T :=
        ⟨(D a b - D c d)⁻¹, Algebra.subset_adjoin (Or.inr ⟨(a, b, c, d), rfl⟩)⟩
      have he : (DA a b - DA c d) * e = 1 := by
        apply Subtype.ext
        change ((DA a b : ℝ) - (DA c d : ℝ)) * (D a b - D c d)⁻¹ = 1
        rw [hDA, hDA]
        exact mul_inv_cancel₀ hne'
      have h1 := congrArg ψ he
      rw [map_mul, map_sub, h, sub_self, zero_mul, map_one] at h1
      exact zero_ne_one h1
    · intro h
      have : DA a b = DA c d := Subtype.ext (by rw [hDA, hDA, h])
      rw [this]
  obtain ⟨i, hi⟩ := IsAlgClosed.exists_pow_nat_eq (-1 : AlgebraicClosure ℚ) (by norm_num : 0 < 2)
  let S : Set (AlgebraicClosure ℚ) := insert i (Set.range (fun p : ι × Fin 2 => ψ (X p.1 p.2)))
  have hSfin : S.Finite := (Set.finite_range _).insert i
  have : Finite S := hSfin.to_subtype
  let K : IntermediateField ℚ (AlgebraicClosure ℚ) := IntermediateField.adjoin ℚ S
  have : FiniteDimensional ℚ K := IntermediateField.finiteDimensional_adjoin
    (fun z _ => OMA.Helpers.isIntegral_algClosure z)
  have hK : NumberField K := NumberField.of_module_finite ℚ K
  let iK : K := ⟨i, IntermediateField.subset_adjoin ℚ S (Set.mem_insert i _)⟩
  let Y : ι → Fin 2 → K := fun a k =>
    ⟨ψ (X a k), IntermediateField.subset_adjoin ℚ S (Set.mem_insert_of_mem _ ⟨(a, k), rfl⟩)⟩
  let u : ι → K := fun a => Y a 0 + iK * Y a 1
  let v : ι → K := fun a => Y a 0 - iK * Y a 1
  have hP : ∀ a b, (((u a - u b) * (v a - v b) : K) : AlgebraicClosure ℚ) = ψ (DA a b) := by
    intro a b
    have e1 : (((u a - u b) * (v a - v b) : K) : AlgebraicClosure ℚ) =
        ((ψ (X a 0) + i * ψ (X a 1)) - (ψ (X b 0) + i * ψ (X b 1))) *
          ((ψ (X a 0) - i * ψ (X a 1)) - (ψ (X b 0) - i * ψ (X b 1))) := rfl
    have e2 : ψ (DA a b) = (ψ (X a 0) - ψ (X b 0)) ^ 2 + (ψ (X a 1) - ψ (X b 1)) ^ 2 := by
      simp only [DA, map_add, map_pow, map_sub]
    rw [e1, e2]
    linear_combination (-(ψ (X a 1) - ψ (X b 1)) ^ 2) * hi
  have key : ∀ a b c d, (u a - u b) * (v a - v b) = (u c - u d) * (v c - v d) ↔
      dist (x a) (x b) = dist (x c) (x d) := by
    intro a b c d
    rw [hdist, ← hψ, ← hP, ← hP]
    exact Subtype.ext_iff
  have hzero : ∀ a b, dist (x a) (x b) = dist (x a) (x a) → a = b := by
    intro a b h
    rw [dist_self] at h
    exact hx (dist_eq_zero.mp h)
  refine ⟨K, hK, iK, u, v, Subtype.ext hi, ?_, ?_, key⟩
  · intro a b hab
    apply hzero a b
    apply (key a b a a).mp
    simp only [hab, sub_self, zero_mul]
  · intro a b hab
    apply hzero a b
    apply (key a b a a).mp
    simp only [hab, sub_self, mul_zero]
