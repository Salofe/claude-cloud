theorem smallPrimes_iff : ∀ q < 222, (q ∈ smallPrimes ↔ Nat.Prime q) := by decide +kernel

theorem smallPrimes_bound : ∀ q ∈ smallPrimes, q < 222 := by decide +kernel

theorem primorial_eq : smallPrimes.prod = primorial := by decide +kernel

theorem tpb_iff (n : ℕ) (hn : n < 49284) : tpb n = true ↔ Nat.Prime n := by
  unfold tpb
  by_cases hs : n < 222
  · rw [if_pos hs, decide_eq_true_iff]
    exact smallPrimes_iff n hs
  · rw [if_neg hs, beq_iff_eq]
    constructor
    · intro h
      by_contra hnp
      have hq := Nat.minFac_prime (show n ≠ 1 by omega)
      have hsq := Nat.minFac_sq_le_self (by omega) hnp
      have hlt : n.minFac < 222 := by
        by_contra hc
        push Not at hc
        have : 222 * 222 ≤ n.minFac * n.minFac := Nat.mul_le_mul hc hc
        nlinarith
      have hmem := (smallPrimes_iff _ hlt).mpr hq
      have hdvd : n.minFac ∣ Nat.gcd n primorial :=
        Nat.dvd_gcd (Nat.minFac_dvd n) (primorial_eq ▸ List.dvd_prod hmem)
      rw [h] at hdvd
      exact hq.one_lt.ne' (Nat.dvd_one.mp hdvd)
    · intro hp
      apply (Nat.Prime.coprime_iff_not_dvd hp).mpr
      rw [← primorial_eq]
      intro hdvd
      obtain ⟨a, ha, hna⟩ := (Nat.prime_iff.mp hp).dvd_prod_iff.mp hdvd
      have ha222 := smallPrimes_bound a ha
      have ha0 : 0 < a := ((smallPrimes_iff a ha222).mp ha).pos
      have := Nat.le_of_dvd ha0 hna
      omega

theorem chainFrom_append (p : ℕ) (l₁ l₂ : List ℕ) :
    chainFrom p (l₁ ++ l₂) = (chainFrom p l₁ && chainFrom (l₁.getLastD p) l₂) := by
  induction l₁ generalizing p with
  | nil => simp [chainFrom]
  | cons b l ih =>
    simp only [List.cons_append, chainFrom, ih, Bool.and_assoc, List.getLastD_cons]

theorem chain_get : ∀ (p : ℕ) (l : List ℕ), chainFrom p l = true → ∀ i, i + 1 < l.length →
    gapOK (l.getD i 0) (l.getD (i + 1) 0) = true
  | _, [], _, i, hi => by simp at hi
  | p, b :: l, h, i, hi => by
    simp only [chainFrom, Bool.and_eq_true] at h
    cases l with
    | nil => simp at hi
    | cons c l =>
      cases i with
      | zero =>
        simp only [chainFrom, Bool.and_eq_true] at h
        simpa using h.2.1
      | succ i => simpa using chain_get b (c :: l) h.2 i (by simpa using hi)

theorem window_gen (rs : List (List ℕ)) (i : ℕ) (hi : i < rs.length) :
    (rs.flatten.drop ((rs.take i).flatten.length)).take (rs.getD i []).length = rs.getD i [] := by
  have hg : rs.getD i [] = rs[i] := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some]
  have e : rs.flatten = (rs.take i).flatten ++ (rs.drop i).flatten := by
    rw [← List.flatten_append, List.take_append_drop]
  rw [e, List.drop_append_length, List.drop_eq_getElem_cons hi, List.flatten_cons, hg,
    List.take_append_length]


