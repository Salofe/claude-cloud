theorem OMA.solution : OMA.R_OeisA7468_conjecture_R1.H1 := by
  intro n hn hle hsq
  by_contra hne
  have hsum : OeisA7468.a n = (OMA.Helpers.rows.getD (n - 1) []).sum := by
    unfold OeisA7468.a
    dsimp only
    rw [← OMA.Helpers.window n hn hle, ← OMA.Helpers.sum_window]
    refine Finset.sum_congr rfl fun i hi => OMA.Helpers.nth_eq _ ?_
    rw [Finset.mem_range] at hi
    have h1 : n * (n - 1) ≤ 100 * 99 := Nat.mul_le_mul hle (by omega)
    have h2 : n * (n - 1) / 2 ≤ 4950 := by omega
    omega
  rw [hsum] at hsq
  obtain ⟨h1, h2⟩ := OMA.Helpers.roots_ok (n - 1) (List.mem_range.mpr (by omega)) (by omega)
  exact OMA.Helpers.not_isSquare_of_between _ _ h1 h2 hsq
