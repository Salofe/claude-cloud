theorem rows_length : rows.length = 100 := by decide +kernel

theorem rows_lengths : rows.map List.length = List.range' 1 100 := by decide +kernel

theorem lengths_ok : ∀ n ∈ List.range' 1 100, (rows.getD (n - 1) []).length = n ∧
    ((List.range' 1 100).take (n - 1)).sum = n * (n - 1) / 2 := by
  decide +kernel

theorem length_L : L.length = 5050 := by
  rw [L, List.length_flatten, rows_lengths]
  decide +kernel

theorem L_zero : L.getD 0 0 = 2 := by decide +kernel

theorem roots_ok : ∀ k ∈ List.range 100, k ≠ 37 →
    roots.getD k 0 * roots.getD k 0 < (rows.getD k []).sum ∧
      (rows.getD k []).sum < (roots.getD k 0 + 1) * (roots.getD k 0 + 1) := by
  decide +kernel

theorem nth_eq : ∀ i, i < 5050 → Nat.nth Nat.Prime i = L.getD i 0
  | 0, _ => by rw [L_zero]; exact Nat.nth_prime_zero_eq_two
  | i + 1, hi => by
    have ih := nth_eq i (by omega)
    have hg := chain_get 1 L chain_L i (by rw [length_L]; omega)
    set a := L.getD i 0 with ha
    set b := L.getD (i + 1) 0 with hb
    simp only [gapOK, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range,
      Bool.not_eq_true'] at hg
    obtain ⟨⟨⟨hab, hb49⟩, hbp⟩, hgap⟩ := hg
    have hbprime : Nat.Prime b := (tpb_iff b hb49).mp hbp
    have haprime : Nat.Prime a := ih ▸ Nat.prime_nth_prime i
    have hca : Nat.count Nat.Prime a = i := by
      rw [← ih]; exact Nat.count_nth_of_infinite Nat.infinite_setOfPred_prime i
    have hgap0 : Nat.count (fun k => Nat.Prime (a + 1 + k)) (b - a - 1) = 0 := by
      rw [Nat.count_eq_card_filter_range, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro k hk hpk
      rw [Finset.mem_range] at hk
      have h1 := hgap k hk
      have h2 := (tpb_iff (a + 1 + k) (by omega)).mpr hpk
      rw [h1] at h2
      exact Bool.false_ne_true h2
    have hcb : Nat.count Nat.Prime b = i + 1 := by
      have e : b = (a + 1) + (b - a - 1) := by omega
      rw [e, Nat.count_add, Nat.count_succ, hca, if_pos haprime, hgap0]
    rw [← hcb]
    exact Nat.nth_count hbprime

theorem sum_window (l : List ℕ) (st : ℕ) : ∀ n,
    ∑ i ∈ Finset.range n, l.getD (st + i) 0 = ((l.drop st).take n).sum
  | 0 => by simp
  | n + 1 => by
    rw [Finset.sum_range_succ, sum_window l st n, List.take_add_one, List.sum_append,
      List.getElem?_drop, List.getD_eq_getElem?_getD]
    cases l[st + n]? <;> simp

theorem not_isSquare_of_between (s r : ℕ) (h1 : r * r < s) (h2 : s < (r + 1) * (r + 1)) :
    ¬ IsSquare s := by
  rintro ⟨m, hm⟩
  rcases Nat.lt_or_ge r m with h | h
  · have : (r + 1) * (r + 1) ≤ m * m := Nat.mul_le_mul h h
    omega
  · have : m * m ≤ r * r := Nat.mul_le_mul h h
    omega

theorem window (n : ℕ) (hn : 0 < n) (hle : n ≤ 100) :
    (L.drop (n * (n - 1) / 2)).take n = rows.getD (n - 1) [] := by
  obtain ⟨h1, h2⟩ := lengths_ok n (List.mem_range'_1.mpr ⟨hn, by omega⟩)
  have hpre : (rows.take (n - 1)).flatten.length = n * (n - 1) / 2 := by
    rw [List.length_flatten, List.map_take, rows_lengths, h2]
  have hlen : n - 1 < rows.length := by rw [rows_length]; omega
  have hw := window_gen rows (n - 1) hlen
  rw [hpre, h1] at hw
  exact hw

